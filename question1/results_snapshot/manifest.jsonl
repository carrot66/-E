{"row_index": 16, "id": "-UuX1xuaiiE$_$3", "video_id": "-UuX1xuaiiE", "clip_id": "3", "text": "My goal is to become a human rights lawyer", "label": 0.3333333432674408, "annotation": "Positive", "source": "-UuX1xuaiiE/3.mp4", "source_sha256": "eddb408f25bdc13e6de2fb74caeed709cb7a8f00640e7897135330437f66a2aa", "status": "complete", "metadata": "samples/-UuX1xuaiiE$_$3/metadata.json", "features": "samples/-UuX1xuaiiE$_$3/features.npz"}
